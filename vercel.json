{
  "buildCommand": "node build.js && cp script.built.js script.js",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/pages/:path*", "destination": "/pages/:path*" },
    { "source": "/admin/:path*", "destination": "/pages/admin/:path*" },
    { "source": "/:page", "destination": "/pages/:page.html" },
    { "source": "/admin/:page", "destination": "/pages/admin/:page.html" }
  ]
}
